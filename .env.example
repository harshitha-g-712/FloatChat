# FloatChat  Environment Configuration
# Copy this file to .env. The application runs 100% offline with zero API keys.
# When a Gemini API key is provided, LLM/RAG features auto-enable for richer responses.

#  AI / Gemini Settings (Recommended for full technology demo)
# Set GEMINI_API_KEY to enable GenAI/LLM intent parsing and RAG answer generation.
# Without a key, FloatChat uses a fast, deterministic local rules engine (zero cost).
USE_GEMINI=true
USE_LLM_EXPLANATION=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

#  Argovis Ingestion Key (Optional)
# Free key from https://argovis-keygen.colorado.edu for higher rate limits during data ingestion
ARGOVIS_API_KEY=

#  Server Configuration
PORT=8000
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Private authentication/session database (separate from ocean observations)
AUTH_DB_PATH=backend/floatchat_auth.db

# Knowledge retrieval — "embedding" (Gemini, default when key is set) or "tfidf" (offline)
RAG_MODE=embedding
RAG_EMBEDDING_MODEL=

# Security options (all optional)
# Interactive API docs (/docs, /redoc, /openapi.json) are OFF unless you set this to true.
ENABLE_DOCS=false
# Content-Security-Policy: "report-only" (default; violations show in the browser console, nothing is blocked),
# "enforce" (block violations; check the console first), or "off".
FLOATCHAT_CSP=report-only
# Set to true ONLY when running behind a reverse proxy you control (it makes the rate limiter trust X-Forwarded-For).
TRUST_X_FORWARDED_FOR=false
